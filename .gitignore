# ============================================================
# YaYa-SaaS-Plus .gitignore
# 构建产物 / 运行时数据 / 敏感配置与密钥 / IDE文件 / 操作系统文件
# ============================================================

# ===== 构建产物 =====
HELP.md
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
build/
!**/src/main/**/build/
!**/src/test/**/build/
/dist/
/nbdist/
/nbproject/private/
/nbbuild/
/.nb-gradle/

# ===== 运行时数据与日志 =====
log/
tmp/
*.log

# ===== 敏感配置与密钥(禁止提交) =====
.env
.env.*
*.local.yml
**/application-*.local.yml
application-local.yml
*.secret
*.pem
*.jks
*.p12
*.pfx

# ===== IDE / 编辑器 =====
### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
### IntelliJ IDEA ###
.idea
*.iws
*.iml
*.ipr
### VS Code ###
.vscode/*
!.vscode/settings.json

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini